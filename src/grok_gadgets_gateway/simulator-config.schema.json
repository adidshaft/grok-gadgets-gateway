{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grok-gadgets:simulator-config:1",
  "title": "Grok Gadgets simulator configuration v1",
  "description": "Local software simulation only. No commands, endpoints or credentials.",
  "type": "object",
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "device_id": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$(?![\\s\\S])", "default": "sim-c124"
    },
    "display_name": {
      "type": "string", "minLength": 1, "maxLength": 80,
      "pattern": "^[ -~]*[!-~][ -~]*$(?![\\s\\S])", "default": "Desk light"
    },
    "initial_rgb": {
      "type": "object",
      "properties": {
        "r": {"type": "integer", "minimum": 0, "maximum": 255},
        "g": {"type": "integer", "minimum": 0, "maximum": 255},
        "b": {"type": "integer", "minimum": 0, "maximum": 255},
        "on": {"type": "boolean"}
      },
      "required": ["r", "g", "b", "on"],
      "additionalProperties": false,
      "default": {"r": 0, "g": 0, "b": 0, "on": false}
    },
    "response_delay_ms": {"type": "integer", "minimum": 0, "maximum": 2000, "default": 0},
    "start_disconnected": {"type": "boolean", "default": false}
  },
  "required": ["schema_version"],
  "additionalProperties": false
}
