<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>xyz.kyokasuigetsu.grok-gadgets-gateway</string>
	<key>ProgramArguments</key>
	<array>
		<string>/ABSOLUTE/PATH/grok-gadgets-gateway</string>
		<string>serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/USER/Library/Logs/grok-gadgets-gateway.log</string>
	<key>StandardOutPath</key>
	<string>/Users/USER/Library/Logs/grok-gadgets-gateway.log</string>
</dict>
</plist>
