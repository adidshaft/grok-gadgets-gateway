{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grok-gadgets:response:0.1.0",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "session_id": {
          "type": "string"
        },
        "protocol_version": {
          "const": "0.1.0"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "command_id",
              "capability",
              "arguments"
            ],
            "properties": {
              "command_id": {
                "type": "string"
              },
              "capability": {
                "type": "string"
              },
              "arguments": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "duplicate": {
          "type": "boolean"
        },
        "claimed": {
          "type": "boolean",
          "description": "Accounts mode, only after a hello with claim (hub ADR 011): whether the gadget has an owner."
        },
        "claim_code": {
          "type": "string",
          "pattern": "^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$",
          "description": "Accounts mode, unclaimed gadgets that opted in: the code to show, valid 10 minutes."
        },
        "update": {
          "description": "Only after a hello with update ready (hub ADR 012): the offered update, or null when an offer made in this session is withdrawn.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "version",
                "size",
                "chunk",
                "manifest",
                "signature"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "maxLength": 32
                },
                "size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8388608
                },
                "chunk": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1024
                },
                "manifest": {
                  "type": "string",
                  "maxLength": 684,
                  "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                },
                "signature": {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "data": {
          "type": "string",
          "maxLength": 1368,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "description": "Reply to update_chunk (hub ADR 012): base64 of at most chunk bytes."
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 64
            },
            "message": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
